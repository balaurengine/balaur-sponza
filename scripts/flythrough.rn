// Drives the player for an offscreen run: walk down the arcade, and write a
// still or one picture a frame when asked. A normal session sets neither, so
// nothing here touches an interactive run.

pub fn exports() {
    #{ shot: "", frames: "" }
}

pub fn init(this) {
    this.frame = 0;
}

pub fn update(this, dt) {
    this.frame += 1;
    // The rig starts facing down the arcade, set as a script property in the
    // scene, so this only has to walk.
    input::feed_key(input::KEY_W, true);
    // A frame carries one screenshot request, so `scripts/media.sh` sets one of
    // these per run rather than both.
    if this.shot != "" && this.frame == 20 {
        render::screenshot(this.shot);
    }
    // Eight seconds at one picture a frame. The offscreen loop draws before it
    // steps, so the first two frames predate the scene's camera.
    if this.frames != "" && this.frame >= 3 && this.frame <= 242 {
        render::screenshot(`${this.frames}/${padded(this.frame)}.png`);
    }
}

// Three digits, so a directory listing plays the frames in order.
fn padded(n) {
    if n < 10 {
        `00${n}`
    } else if n < 100 {
        `0${n}`
    } else {
        `${n}`
    }
}
